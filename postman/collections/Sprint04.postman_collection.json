        {
          "name": "Public Channel 생성",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "730e2a31-ebe1-4f45-b61d-5823a3199379",
                "exec": [
                  "// 1. 응답 데이터를 JSON 형태로 파싱하여 변수에 담습니다.\r",
                  "const jsonData = pm.response.json();\r",
                  "\r",
                  "// 2. 응답 데이터에 ID가 포함되어 있는지 확인 후 저장합니다.\r",
                  "if (jsonData.id) {\r",
                  "    // 컬렉션 변수(Collection Variables)에 'channelId'라는 이름으로 저장합니다.\r",
                  "    pm.collectionVariables.set(\"channelId\", jsonData.id);\r",
                  "    \r",
                  "    // 제대로 저장되었는지 확인하기 위해 콘솔에 출력합니다. (Ctrl+Alt+C로 확인 가능)\r",
                  "    console.log(\"새로운 채널 ID가 저장되었습니다: \" + jsonData.id);\r",
                  "} else {\r",
                  "    console.error(\"응답 데이터에서 ID를 찾을 수 없습니다.\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
