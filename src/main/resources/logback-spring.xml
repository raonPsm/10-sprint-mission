<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <property name="LOG_PATTERN"
    value="%d{yy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
  <!--
  로그가 출력될 포맷을 정의
    - %d{yy-MM-dd HH:mm:ss.SSS} : `25-01-01 10:33:55.740` 포맷
    - [%thread] : 로그를 발생시킨 스레드 이름
    - %-5level : 로그 레벨 / -5는 5글자 너비로 왼쪽 정렬
    - %logger{36} : 로깅을 수행한 클래스 이름 / {36}은 최대 36글자까지만 표시하고 넘어가면 패키지명을 축약
    - %msg : 실제 코드에서 작성한 로그 메시지 본문
    - %n : 줄바꿈
  -->
  <property name="LOG_DIR" value=".logs"/> <!-- 로그 파일이 저장될 디렉토리 경로 -->
  <property name="LOG_FILE_NAME" value="application"/> <!-- 생성될 로그 파일의 기본 이름 -->

  <!-- appender - 로그를 어디에 출력할지 결정하는 컴포넌트 -->
  <!-- CONSOLE appender : 콘솔 출력 설정 -->
  <!-- ch.qos : Logback 개발사인 qos.ch -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder> <!-- 로그 이벤트를 바이트 배열로 변환하여 출력스트림에 쓰는 역할 -->
      <pattern>${LOG_PATTERN}</pattern> <!-- LOG_PATTERN 변수를 가져와서 적용 -->
    </encoder>
  </appender>

  <!-- FILE appender : 파일 출력 및 롤링 정책 설정 -->
  <!--
      RollingFileAppender: 여러 파일에 이어서 로그를 기록할 수 있게 해주는 appender
      특정 조건(시간, 크기 등)이 되면 기존 파일을 닫고 새로운 파일을 생성(Rolling)
  -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/${LOG_FILE_NAME}.log</file>
    <!-- 현재 실시간으로 로그가 기록되고 있는 활성 로그 파일의 이름 (.logs/application.log) -->
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
    </encoder>

    <!-- 롤링(파일 분리) 정책을 설정 : TimeBasedRollingPolicy(시간 기반 롤링)  -->
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <!--
        하루가 지나서 과거 로그가 될 때 파일의 이름을 어떻게 바꿀지 결정
        매일 자정이 되면 날짜가 포함된 이름(.logs/application-2025-01-01.log)으로 압축/저장되고,
        새로운 application.log 파일이 생성
      -->
      <fileNamePattern>${LOG_DIR}/${LOG_FILE_NAME}-%d{yyyy-MM-dd}.log</fileNamePattern>
      <!--보관기간(30일) 설정. 30일이 지난 오래된 로그 파일은 자동으로 삭제됨 -->
      <maxHistory>30</maxHistory>
    </rollingPolicy>
  </appender>

  <!-- Root Logger: 기본 동작 설정 -->
  <!-- 애플리케이션의 기본 로그 레벨을 INFO로 설정 / yaml 파일이 덮어씌움 -->
  <root level="INFO">
    <!-- appender-ref : CONSOLE과 FILE appender를 root logger에 등록 -->
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>

</configuration>