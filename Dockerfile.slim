# === (1) Builder Stage ===
# 소스 코드를 컴파일하기 위한 빌드 전용 스테이지
FROM amazoncorretto:17-alpine AS builder

# root 권한으로 초기 설정 수행
USER root
WORKDIR /app

# Gradle이 다운로드한 의존성과 캐시를 저장할 디렉터리 경로 지정
# 이 경로를 명시해야 레이어 캐시와 함께 의존성 캐시도 재활용할 수 있다.
ENV GRADLE_USER_HOME=/home/gradle/.gradle

# gradle을 생성하여 빌드를 실행 - 컨테이너 내부에서 불필요한 root 권한 사용을 방지
# 필요한 디렉터리에 대한 소유권도 함께 설정
RUN adduser -D gradle && \
    mkdir -p $GRADLE_USER_HOME && \
    chown -R gradle:gradle /home/gradle /app

# 이후 모든 명령을 gradle 사용자로 실행
USER gradle

# === 1단계: 의존성 관련 파일만 먼저 복사 (레이어 캐시 활용) ===
# build.gradle / settings.gradle 이 변경되지 않으면 이 레이어는 캐시 재사용
# 의존성 정의 파일을 소스 코드보다 먼저 복사하면,
# 소스 코드만 변경된 경우 의존성 다운로드 레이어는 캐시에서 가져와 빌드 시간을 크게 단축한다.
COPY --chown=gradle:gradle gradlew ./
COPY --chown=gradle:gradle gradle ./gradle
COPY --chown=gradle:gradle build.gradle settings.gradle ./

# gradlew 스크립트에 실행 권한 부여
RUN chmod +x ./gradlew

# 의존성만 미리 다운로드
# || true : 이 시점엔 src/ 디렉터리가 아직 복사되지 않았기 때문에 일부 하위 태스크가 실패할 수 있음
#           소스 코드가 없어 일부 태스크가 실패하더라도 Docker 빌드가 중단되지 않도록 하는 안전장치
# 이 레이어는 build.gradle이 변경되지 않는 한 캐시된다.
RUN ./gradlew --no-daemon dependencies || true

# === 2단계: 소스 코드 복사 및 실제 빌드 ===
# 소스 코드가 변경될 때만 이 레이어부터 재빌드된다.
COPY --chown=gradle:gradle src ./src

# 애플리케이션을 빌드하여 실행 가능한 JAR 파일 생성
# --no-daemon: 컨테이너 내에서는 Gradle 데몬이 불필요하므로 비활성화 (메모리 절약)
# --no-parallel: 병렬 빌드 비활성화로 메모리 사용량 제한 (CI 환경에서 안정적)
# -x test: 테스트 생략 (CI 파이프라인에서 별도로 실행하는 것이 일반적)
RUN ./gradlew clean build --no-daemon --no-parallel -x test

# === (2) Runtime Base Stage — 커스텀 경량 JRE 생성 ===
# jlink를 사용해 애플리케이션에 필요한 Java 모듈만 골라낸 커스텀 JRE 만들기
# 전체 JDK(~340MB) 대신 ~100MB 수준으로 줄일 수 있다.
# amazoncorretto:17-alpine (~340MB JDK) vs alpine + custom JRE (~100MB)
FROM amazoncorretto:17-alpine AS runtime-base

# jlink의 --strip-debug에 필요한 objcopy 설치
# --no-cache: apk 패키지 인덱스를 로컬에 저장하지 않아 이미지 크기를 줄인다.
RUN apk add --no-cache binutils

# jlink로 필요한 모듈만 포함하는 커스텀 JRE 생성
# jlink: Java 9+에서 제공하는 모듈화 도구로, 필요한 모듈만 포함하는 맞춤형 JRE를 생성
# 각 모듈의 역할:
#   java.base          — 모든 Java 프로그램의 기본 (String, List, Stream 등)
#   java.logging       — java.util.logging (SLF4J/Logback이 내부적으로 참조)
#   java.naming        — JNDI, DNS 조회 (DataSource 연결 등에 사용)
#   java.net.http      — Java 11+ HTTP 클라이언트 (HttpClient)
#   java.security.jgss — Kerberos/GSS-API 보안 인증
#   java.sql           — JDBC (데이터베이스 연결의 핵심)
#   java.xml           — XML 파싱 (Spring 내부에서 광범위하게 사용)
#   java.desktop       — AWT/이미지 처리 (일부 라이브러리가 간접적으로 의존)
#   java.management    — JMX (Spring Actuator, 모니터링 메트릭)
#   java.instrument    — Java Agent 지원 (APM 도구, 바이트코드 조작 등)
#   jdk.unsupported    — sun.misc.Unsafe 등 (Netty, 직렬화 라이브러리가 의존)
#   jdk.crypto.ec      — 타원 곡선 암호화 (HTTPS/TLS 연결에 필수)
#
# --strip-debug        — 디버그 심볼을 제거하여 바이너리 크기를 대폭 축소
# --no-man-pages       — man 페이지 제외 (런타임에 불필요)
# --no-header-files    — C 헤더 파일 제외 (JNI 개발용이므로 런타임에 불필요)
# --compress=2         — ZIP 압축 적용으로 추가 크기 절감
# --output             — 생성된 커스텀 JRE의 출력 경로
RUN jlink \
    --add-modules java.base,java.logging,java.naming,java.net.http,java.security.jgss,java.sql,java.xml,java.desktop,java.management,java.instrument,jdk.unsupported,jdk.crypto.ec \
    --strip-debug \
    --no-man-pages \
    --no-header-files \
    --compress=2 \
    --output /opt/jre-minimal

# ===Final Stage — 실제 배포되는 최종 이미지 ===
# 순수 Alpine Linux(~5MB)를 베이스로 사용
FROM alpine:3.19

# JRE 실행에 필요한 최소 라이브러리
# libstdc++ — GNU C++ 표준 라이브러리 (HotSpot JVM(libjvm.so)은 C++로 작성돼 있음)
# gcompat — glibc 호환 레이어 (glibc 바이너리를 musl 환경에서 실행할 수 있게 해주는 호환성 심(shim))
RUN apk add --no-cache libstdc++ gcompat

# 커스텀 JRE 복사
COPY --from=runtime-base /opt/jre-minimal /opt/jre
ENV JAVA_HOME=/opt/jre
# java 명령어를 시스템 전역에서 사용할 수 있도록 환경 변수 설정
ENV PATH="$JAVA_HOME/bin:$PATH"

WORKDIR /app

ARG PROJECT_NAME=discodeit
ARG PROJECT_VERSION=1.2-M8

# 빌드 스테이지에서 JAR만 복사
COPY --from=builder /app/build/libs/${PROJECT_NAME}-${PROJECT_VERSION}.jar ./

# 컨테이너가 80번 포트를 사용함을 명시
EXPOSE 80

ENV PROJECT_NAME=${PROJECT_NAME}
ENV PROJECT_VERSION=${PROJECT_VERSION}
ENV JVM_OPTS=""
ENV SPRING_PROFILES_ACTIVE=dev

ENTRYPOINT ["sh", "-c", "exec java $JVM_OPTS -jar ${PROJECT_NAME}-${PROJECT_VERSION}.jar"]
